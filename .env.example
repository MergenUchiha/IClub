# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit the filled-in file.
# Every variable listed here is read by the application; the app refuses to
# start with a clear message if a required one is missing or malformed.
# ---------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
PORT=5005
# Public address of this API. Used to build absolute URLs for uploaded files.
BACKEND_URL=http://localhost:5005

# Signing key for cookies. At least 16 characters.
COOKIE_SECRET=change-me-to-a-long-random-string

# Serves the API reference at /docs. Keep it 'false' in production.
IS_SWAGGER_ENABLED=true

# Comma-separated origins allowed to call the API with credentials.
# Required in production; empty in development means "allow localhost".
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iclub?schema=public

# --- JWT (users) ---
# Secrets: at least 16 characters, different from each other.
JWT_ACCESS_SECRET=change-me-user-access-secret
JWT_REFRESH_SECRET=change-me-user-refresh-secret
# Lifetimes use the zeit/ms format: 15m, 1h, 1d, 30d.
JWT_ACCESS_TIME=1h
JWT_REFRESH_TIME=30d

# --- JWT (admins) ---
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access-secret
JWT_ADMIN_REFRESH_SECRET=change-me-admin-refresh-secret
JWT_ADMIN_ACCESS_TIME=1h
JWT_ADMIN_REFRESH_TIME=30d

# --- Default admin ---
# Created on first boot if no admin with this username exists.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-at-least-8-chars

# --- Health check ---
# GET /api/health expects: Authorization: Bearer <this value>
HEALTH_CHECK_TOKEN=change-me-to-a-long-random-string

# --- Rate limiting ---
# Counters live in Redis, so limits are shared across instances.
# Redis is required only when NODE_ENV=production.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
# Window in milliseconds and the number of requests allowed inside it.
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# --- Error reporting (optional) ---
# Leave empty to disable Sentry entirely.
SENTRY_DSN=
