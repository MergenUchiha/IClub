{
    "name": "iclub",
    "version": "1.0.0",
    "description": "REST API for the IClub student club: room bookings, caf\u00e9 orders and catalogue management.",
    "author": "MergenUchiha",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "prisma:generate": "prisma generate --schema ./src/prisma/schema",
        "prisma:migrate": "prisma migrate dev --schema ./src/prisma/schema",
        "prisma:deploy": "prisma migrate deploy --schema ./src/prisma/schema",
        "prisma:studio": "prisma studio --schema ./src/prisma/schema",
        "seed": "ts-node -r tsconfig-paths/register src/helpers/seeds/seed.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^10.0.2",
        "@fastify/helmet": "^13.0.1",
        "@fastify/multipart": "^9.0.3",
        "@fastify/static": "^10.1.2",
        "@nest-lab/throttler-storage-redis": "^1.2.0",
        "@nestjs/common": "^11.0.10",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.10",
        "@nestjs/platform-fastify": "^11.0.10",
        "@nestjs/swagger": ">=11.0.4 <11.4.3",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/throttler": "^6.4.0",
        "@prisma/client": "^6.4.1",
        "@sentry/nestjs": "^9.1.0",
        "argon2": "^0.41.1",
        "class-transformer": "^0.5.1",
        "dotenv": "^16.4.7",
        "fastify-file-interceptor": "^1.0.9",
        "ioredis": "^5.7.0",
        "jsonwebtoken": "^9.0.2",
        "nestjs-zod": "^4.3.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "zod": "^3.24.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@golevelup/ts-jest": "^0.6.2",
        "@nestjs/cli": "^11.0.4",
        "@nestjs/schematics": "^11.0.1",
        "@nestjs/testing": "^11.0.10",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.18",
        "@types/compression": "^1.7.5",
        "@types/express": "^5.0.0",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.13.5",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-module-resolver": "^1.5.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "fastify": "^5.11.3",
        "globals": "^15.15.0",
        "jest": "^29.7.0",
        "prettier": "^3.5.2",
        "prisma": "^6.4.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.6",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.29.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "moduleDirectories": [
            "node_modules",
            "src"
        ],
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "overrides": {
        "fastify": "^5.11.3"
    }
}
